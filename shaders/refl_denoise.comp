#version 460
// REFLECTION DENOISE — edge-aware a-trous wavelet filter over the half-res
// reflection buffer. One dispatch per a-trous iteration; the tap spacing
// DOUBLES each iteration (push constant `step`).
//
// CLEAN-ROOM, original work. Built from published, non-engine references only:
// the edge-avoiding a-trous wavelet transform (Dammertz et al., HPG 2010), the
// depth/normal edge-stopping weight formulation from spatiotemporal
// variance-guided filtering (Schied et al., HPG 2017), Real-Time Rendering 4th
// ed. on joint-bilateral filtering, and — most directly — THIS REPO'S OWN
// in-house pattern for exactly this class of problem: shaders/ssgi_blur.frag
// (depth-aware bilateral with an a-trous `stepScale`) and
// shaders/ssgi_temporal.frag (distance-relative rejection tolerance). No GPL /
// id Tech / RBDOOM / Unreal source consulted. See docs/CLEANROOM_PROCESS.md.
//
// THIS SHADER IS A TRANSCRIPTION of x3::refldn::filterIteration() in
// engine/rhi/ReflDenoise.cpp. That C++ copy is the testable definition
// (--test-refldenoise asserts edge preservation, energy conservation and
// off-is-identity on synthetic buffers with no GPU); this copy is what actually
// runs. Keep them in sync — the screenshots are the gate on this one.
//
// WHY IT EXISTS: shaders/ssgi_gather -> ssgi_temporal -> ssgi_blur -> ssgi_apply
// is a full gather/temporal/denoise/apply chain for GI. Reflections had NO
// equivalent: refl.comp wrote and mesh.frag consumed raw. On the real hero car
// (CTR_Body, base rough 0.4 / metal 0.8) that raw buffer reads as blotchy
// streaky mottling — mean |px - 9x9 local mean| on flat door skin went 5.53
// (reflections off) -> 7.69 (shipped), and sweeping mesh.frag's consumer blur
// disc across radii 0/6/14/24 moved it only 7.70/7.92/7.69/7.56. The noise is
// in the BUFFER; this pass is the missing stage.
//
// THE TWO EDGE STOPS ARE THE POINT. Without them this is a box blur and it
// smears reflections across the car's lower silhouette onto the floor — which
// is the SECOND reported defect. --test-refldenoise keeps that exact box blur
// as a permanent negative control and requires it to FAIL the edge assertions.

layout(local_size_x = 8, local_size_y = 8) in;

// Source reflection buffer (rgba16f: rgb = reflected radiance, a = confidence).
// Iteration 0 reads refl.comp's output; later iterations read the previous
// iteration's target (ping-pong). Sampled with texelFetch — the a-trous taps are
// exact texel offsets, no filtering wanted.
layout(set = 0, binding = 0) uniform sampler2D srcTex;
// Destination (rgba16f storage image, GENERAL).
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dstImg;
// AUX geometry written by refl.comp at the SAME half-res grid:
//   rgb = world-space geometric normal (the very normal that generated the
//         reflection ray, so the edge stop is consistent with the tracer)
//   a   = view distance in metres; <= 0 means SKY / early-out / no surface.
// This is why the pass needs no depth binding and no inverse-viewProj: one
// texel fetch per tap gives both edge-stop inputs. (The normal cannot be
// re-derived cheaply here — reconstructing it from depth per TAP would be ~5
// depth fetches x 25 taps x N iterations.)
layout(set = 0, binding = 2) uniform sampler2D auxTex;

layout(push_constant) uniform Push {
    // x = width, y = height, z = tap spacing (1, 2, 4, ...), w = depthSigma
    vec4 params0;
    // x = normalPow, yzw = reserved
    vec4 params1;
} pc;

// A-trous 5x5 B3-spline row [1 4 6 4 1]/16, used as an outer product.
// MUST match x3::refldn::kAtrousRow.
const float kRow[5] = float[5](0.0625, 0.25, 0.375, 0.25, 0.0625);

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    int W = int(pc.params0.x);
    int H = int(pc.params0.y);
    if (px.x >= W || px.y >= H) return;

    int   step       = max(int(pc.params0.z), 1);
    float depthSigma = max(pc.params0.w, 1e-4);
    float normalPow  = max(pc.params1.x, 0.0);

    vec4 c  = texelFetch(srcTex, px, 0);
    vec4 a0 = texelFetch(auxTex, px, 0);

    // SKY / no-surface centre: refl.comp wrote nothing meaningful, so pass it
    // through rather than dragging neighbouring reflections into the sky.
    if (!(a0.w > 0.0)) { imageStore(dstImg, px, c); return; }

    vec3  n0   = a0.xyz;
    float dist = a0.w;
    float tol  = depthSigma * dist;

    // sumW normalises CONFIDENCE (pure geometric/spatial weight); sumCW
    // normalises COLOUR (weight * confidence). Accumulating colour PREMULTIPLIED
    // by confidence is what stops a zero-confidence neighbour — whose stored
    // colour is BLACK — from darkening a confident pixel. Averaging rgb and a
    // independently (what mesh.frag's consumer disc does) darkens instead, and
    // that binary confidence field IS the measured blotch: refl.comp either
    // finds a march hit or it does not, and on a curved glossy panel that
    // decision flips pixel to pixel.
    float sumW  = 0.0;
    float sumCW = 0.0;
    vec3  sumC  = vec3(0.0);

    for (int ky = -2; ky <= 2; ++ky) {
        for (int kx = -2; kx <= 2; ++kx) {
            ivec2 tp = clamp(px + ivec2(kx, ky) * step, ivec2(0), ivec2(W - 1, H - 1));
            vec4  at = texelFetch(auxTex, tp, 0);
            if (!(at.w > 0.0)) continue;                   // sky / invalid tap

            float wt = kRow[kx + 2] * kRow[ky + 2];

            // DEPTH stop — tolerance RELATIVE to view distance so far geometry
            // (coarser depth, bigger texel footprint) is not over-rejected; the
            // ssgi_temporal.frag rule. This is the term that refuses to filter
            // across the car's lower silhouette onto the floor.
            wt *= exp(-abs(at.w - dist) / tol);

            // NORMAL stop — catches creases and silhouettes at a SIMILAR depth
            // (a mirror housing against the door behind it) that the depth term
            // cannot see. Deliberately permissive (pow 16): a car panel curves
            // continuously and we WANT to filter across that curvature, since
            // that divergence is where the noise lives.
            wt *= pow(max(dot(n0, at.xyz), 0.0), normalPow);

            if (!(wt > 0.0)) continue;
            vec4  s  = texelFetch(srcTex, tp, 0);
            float cw = wt * max(s.a, 0.0);
            sumW  += wt;
            sumCW += cw;
            sumC  += cw * s.rgb;
        }
    }

    vec4 o = c;
    if (sumW > 0.0) {
        o.a = sumCW / sumW;
        // No confident neighbour anywhere in the footprint: keep the centre's
        // colour rather than inventing one. Its confidence is ~0 either way, so
        // mesh.frag's blend weight discards it.
        o.rgb = (sumCW > 1e-8) ? (sumC / sumCW) : c.rgb;
    }
    imageStore(dstImg, px, o);
}
