# Build output
/build/
/out/
cmake-build-*/
/bin/
/lib/
*.obj
*.o
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib

# Visual Studio
.vs/
*.user
*.suo
CMakeSettings.json
.vscode/

# vcpkg
/vcpkg/
/vcpkg_installed/

# Shader compile output
*.spv

# Pak build output
*.x3pak

# Curated game-model assets are now COMMITTED via Git LFS (see .gitattributes:
# *.glb/*.gltf/*.fbx/*.ktx2/*.bin) so the repo is portable across machines.
# (Previously /assets/ was ignored and shipped separately.)
/games/*/content/

# Large / commercial game assets (never commit)
/base/
*.pk4
*.x3pak

# --capture-ai tool output (generated PNG frame sequence + assembled GIF)
/ai_action/
/ai_action*/
ai_action*.gif

# Tracy captures
*.tracy

# LLM model weights (~2 GB) — never in git/LFS. Download per
# assets/models/llm/README.md (the game runs modelless without them).
assets/models/llm/*.gguf

# Claude Code background sub-agent worktrees — each is a FULL repo checkout
# (gigabytes of duplicated assets + build dirs). Local-only, never commit.
# Clean periodically: tools/clean_worktrees.ps1  (see README warning).
.claude/worktrees/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

build-local.bat
build-local.log
configure.log
configure2.log
buildstep.log
buildstep2.log
buildstep3.log
run.log
runerr.log
run.pid
*.log

# Loose scratch screenshots in repo root (keep curated ones in docs/screenshots/)
/*.png
/*.gif

# Runtime / scratch artifacts
imgui.ini
b1log.txt
*terminal log*.txt
*.done
tools/__pycache__/
assets/fonts/*.zip

# Render-proof captures — regenerable via --screenshot-* (don't bloat history)
captures/

# ShowRoom_Vol30: commit ONLY the assembled, re-skinned Example_01.glb (the scene the
# game loads). The other ~79 raw kit pieces + the .orig/.hdrp backups are large and
# REGENERABLE from the Unity kit via the committed converter
# (python tools/convert_unity_pack.py repack-glb <kit> Example_01.orig.glb Example_01.glb),
# so they stay out of LFS (the kit is the source of truth).
assets/converted_glb/ShowRoom_Vol30/*
!assets/converted_glb/ShowRoom_Vol30/Example_01.glb
