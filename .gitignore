# Build output
/build/
/out/
cmake-build-*/
/bin/
/lib/
*.obj
*.o
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib

# Visual Studio
.vs/
*.user
*.suo
CMakeSettings.json
.vscode/

# vcpkg
/vcpkg/
/vcpkg_installed/

# Shader compile output
*.spv

# Pak build output
*.x3pak

# Curated game-model assets are now COMMITTED via Git LFS (see .gitattributes:
# *.glb/*.gltf/*.fbx/*.ktx2/*.bin) so the repo is portable across machines.
# (Previously /assets/ was ignored and shipped separately.)
/games/*/content/

# Large / commercial game assets (never commit)
/base/
*.pk4
*.x3pak

# --capture-ai tool output (generated PNG frame sequence + assembled GIF)
/ai_action/
/ai_action*/
ai_action*.gif

# Tracy captures
*.tracy

# LLM model weights (~2 GB GGUFs) — NEVER in git/LFS; nearly committed twice in
# June 2026. Download per assets/models/llm/README.md (branch feat/llm-npc);
# the game runs modelless without them. Belt + suspenders with the pre-commit
# guard (tools/hooks/pre-commit), which hard-blocks *.gguf even when forced.
*.gguf
assets/models/llm/*
!assets/models/llm/README.md

# Crash dumps anywhere in the tree (crashdumps/ is ignored below, but dumps
# also land next to the exe / in repo root). *.pdb is already ignored above.
*.dmp
MEMORY.DMP

# Claude Code background sub-agent worktrees — each is a FULL repo checkout
# (gigabytes of duplicated assets + build dirs). Local-only, never commit.
# Clean periodically: tools/clean_worktrees.ps1  (see README warning).
.claude/worktrees/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

build-local.bat
build-local.log
configure.log
configure2.log
buildstep.log
buildstep2.log
buildstep3.log
run.log
runerr.log
run.pid
*.log

# Loose scratch screenshots in repo root (keep curated ones in docs/screenshots/)
/*.png
/*.gif

# Runtime / scratch artifacts
imgui.ini
b1log.txt
*terminal log*.txt
*.done
tools/__pycache__/
assets/fonts/*.zip

# Render-proof captures — regenerable via --screenshot-* (don't bloat history)
captures/

# ShowRoom_Vol30: commit ONLY the assembled, re-skinned Example_01.glb (the scene the
# game loads). The other ~79 raw kit pieces + the .orig/.hdrp backups are large and
# REGENERABLE from the Unity kit via the committed converter
# (python tools/convert_unity_pack.py repack-glb <kit> Example_01.orig.glb Example_01.glb),
# so they stay out of LFS (the kit is the source of truth).
assets/converted_glb/ShowRoom_Vol30/*
!assets/converted_glb/ShowRoom_Vol30/Example_01.glb
.staging/

# Performance-shop build save (per-machine player state)
vehbuild.json
assets/surface_library/
assets/converted_glb/Detention/
assets/converted_glb/ModularSciFi_Interior/SM_Wall_B.glb
assets/converted_glb/ModularSciFi_Interior/SM_Wall_C.glb
assets/rigged_glb/FPArms_Jake.glb
assets/rigged_glb/alien_crawler_anim.glb
assets/rigged_glb/chief_martinez_anim.glb
assets/rigged_glb/marcus_webb_anim.glb
# Weapon viewmodels (2026-07-11): regenerated by tools/rebind_weapon_textures.py and
# distributed via the asset store, NOT Git LFS (the LFS budget is exhausted -- fetches
# hard-fail fleet-wide). Untracked here so a `git add` can never push a new LFS object.
# Hydrate with: python tools/asset_store.py fetch --all
assets/rigged_glb/WeaponEnergyPistol2.glb
assets/rigged_glb/WeaponShotgun2.glb
assets/rigged_glb/WeaponRocketLauncher.glb
assets/rigged_glb/WeaponBFG.glb
assets/rigged_glb/WeaponRailgun.glb

# L6 (docs/KNOWN_BUGS.md): ONE BUILD DIR PER AGENT. Concurrent agents sharing a build
# dir silently debug a STALE exe (MSBuild holds .obj files and skips recompiles). Agents
# build to build-<name>/ inside their own worktree — never commit those.
build-*/
