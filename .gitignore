CMakeSettings.json
.vscode/

# vcpkg
/vcpkg/
/vcpkg_installed/

# Shader compile output
*.spv

# Pak build output
*.x3pak

# Curated game-model assets are now COMMITTED via Git LFS (see .gitattributes:
# *.glb/*.gltf/*.fbx/*.ktx2/*.bin) so the repo is portable across machines.
# (Previously /assets/ was ignored and shipped separately.)
/games/*/content/

# Large / commercial game assets (never commit)
/base/
*.pk4
*.x3pak

# --capture-ai tool output (generated PNG frame sequence + assembled GIF)
/ai_action/
/ai_action*/
ai_action*.gif

# Tracy captures
*.tracy

# Claude Code background sub-agent worktrees — each is a FULL repo checkout
# (gigabytes of duplicated assets + build dirs). Local-only, never commit.
# Clean periodically: tools/clean_worktrees.ps1  (see README warning).
.claude/worktrees/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

build-local.bat
build-local.log
configure.log
configure2.log
buildstep.log
buildstep2.log
buildstep3.log
run.log
runerr.log
run.pid
*.log

# Loose scratch screenshots in repo root (keep curated ones in docs/screenshots/)
/*.png
/*.gif
