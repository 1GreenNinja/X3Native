{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 (VS2026 + vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "USE_GPL_SCAFFOLD": "OFF"
      },
      "environment": {
        "_NOTE": "Set VCPKG_ROOT to your vcpkg clone, e.g. C:/vcpkg. Vulkan SDK must be installed (winget install KhronosGroup.VulkanSDK)."
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (cmd-line)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "USE_GPL_SCAFFOLD": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-vs2026", "configurePreset": "windows-vs2026", "configuration": "Release" },
    { "name": "ninja-release",  "configurePreset": "ninja-release" }
  ]
}
